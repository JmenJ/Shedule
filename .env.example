BOT_TOKEN=replace-with-a-new-token-from-botfather
BOT_OWNER_IDS=123456789
DATABASE_URL=postgresql://user:password@host:5432/database
WEBHOOK_URL=https://your-service.onrender.com
WEBHOOK_SECRET=replace_with_a_long_random_secret
DEFAULT_TIMEZONE=Europe/Moscow
SETUP_CODE_TTL_HOURS=24
PORT=10000

# VK browser relay (off until the group, persistent DB and session are configured)
VK_RELAY_ENABLED=0
VK_RELAY_ONLY=1
VK_RELAY_STORAGE=memory
VK_PEER_ID=2000000012
VK_REVIEW_MENTION=@thelovelesss
VK_SESSION_FILE=/etc/secrets/vk_auth.json
VK_REFRESH_SECONDS=120
